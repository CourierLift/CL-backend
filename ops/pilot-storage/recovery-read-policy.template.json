{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectPilotBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicyStatus",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__"
    },
    {
      "Sid": "ListOnlyProofAndBackupVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__",
      "Condition": {"StringLike": {"s3:prefix": ["proofs/", "proofs/*", "backups/", "backups/*"]}}
    },
    {
      "Sid": "ReadExactProofAndBackupVersions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::__BUCKET_NAME__/proofs/*",
        "arn:aws:s3:::__BUCKET_NAME__/backups/*"
      ]
    }
  ]
}
