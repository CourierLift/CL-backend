CL_APP_ENV=development
CL_SECRET_KEY=replace-with-a-long-random-secret
CL_JWT_ALGORITHM=HS256
CL_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CL_DATABASE_URL=sqlite:///./courier_lifts.db
CL_FRONTEND_ORIGIN=http://localhost:5173
CL_DEVELOPMENT_FALLBACK_MILES=8.0
CL_AUTH_REGISTER_RATE_LIMIT=10
CL_AUTH_LOGIN_RATE_LIMIT=20
CL_AUTH_RATE_WINDOW_SECONDS=60
CL_OBJECT_STORAGE_BACKEND=local
CL_OBJECT_STORAGE_PATH=./object_storage
CL_S3_BUCKET=
CL_S3_REGION=us-east-1
CL_S3_ENDPOINT_URL=
CL_PROOF_MAX_BYTES=10485760
